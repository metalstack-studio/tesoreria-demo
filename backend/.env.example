# ============================================================
#  Variables de entorno del BACKEND (Node/Express)
# ============================================================
#  Copiá a "backend/.env" y completá los valores reales.
# ============================================================

# Cadena de conexión a Postgres.
# host=localhost, puerto=5433 (el DB_PORT que mapeamos en docker-compose).
DATABASE_URL=postgresql://tesoreria:cambia_esta_password@localhost:5433/tesoreria

# Secreto para FIRMAR los tokens JWT. Poné algo largo y aleatorio.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Cuánto dura el token antes de expirar.
JWT_EXPIRES_IN=1d

# Puerto donde escucha la API Express.
PORT=4000

# ------------------------------------------------------------
#  Proveedor de IA (compatible con la API de OpenAI)
# ------------------------------------------------------------
#  Usamos nombres LLM_* propios para que NO choquen con variables
#  globales del shell (OPENAI_API_KEY / OPENAI_BASE_URL).
#
#  Ejemplos de configuración según proveedor:
#
#  · OpenRouter (agregador; muchos modelos, algunos gratis):
#      LLM_BASE_URL=https://openrouter.ai/api/v1
#      LLM_MODEL=openai/gpt-4o-mini
#
#  · OpenAI directo:
#      LLM_BASE_URL=https://api.openai.com/v1
#      LLM_MODEL=gpt-4o-mini
#
#  · Groq:
#      LLM_BASE_URL=https://api.groq.com/openai/v1
#      LLM_MODEL=llama-3.1-8b-instant
# ------------------------------------------------------------
LLM_API_KEY=tu-api-key-aca
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
