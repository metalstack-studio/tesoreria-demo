# ============================================================
#  Variables de entorno · PLANTILLA
# ============================================================
#  Copiá este archivo a ".env" y completá los valores reales.
#  El ".env" real NUNCA se sube a git (está en .gitignore).
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=tesoreria
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=tesoreria
# Puerto en TU máquina (host). El contenedor internamente siempre usa 5432.
DB_PORT=5433

# --- Backend (se usan a partir de la Fase 2) ---
# Cadena de conexión que usará Node para hablar con Postgres.
# Ojo: el host es localhost y el puerto es el DB_PORT de arriba (5433).
DATABASE_URL=postgresql://tesoreria:cambia_esta_password@localhost:5433/tesoreria
# Clave para firmar los tokens JWT (poné algo largo y aleatorio).
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Puerto donde escucha la API Express.
PORT=4000

# --- OpenAI (se usa a partir de la Fase 3) ---
OPENAI_API_KEY=sk-tu-api-key-aca
