# ============================================================
#  Variables de entorno de INFRAESTRUCTURA (Docker / Postgres)
# ============================================================
#  Las lee docker-compose para crear la base.
#  Copiá este archivo a ".env" y completá los valores reales.
#  El backend tiene su PROPIO .env en backend/.env
# ============================================================

POSTGRES_USER=tesoreria
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=tesoreria
# Puerto en TU máquina (host). El contenedor internamente usa 5432.
DB_PORT=5433
